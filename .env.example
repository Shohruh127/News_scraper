# Copy to .env and fill in. Never commit .env.

# --- Ollama (org LAN) ---
# Base URL of the remote Ollama server. No trailing slash.
OLLAMA_BASE_URL=
# Pinned model tags. Never use a ":latest" tag here — it is a moving pointer
# and would silently change results between runs.
OLLAMA_FAST_MODEL=
OLLAMA_DEEP_MODEL=
# Seconds. The deep model has been observed above 98s on large prompts.
OLLAMA_FAST_TIMEOUT=60
OLLAMA_DEEP_TIMEOUT=300

# --- PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=news_radar
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Telegram (needed from T1.8 onward) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHANNEL_ID=
TELEGRAM_TEST_GROUP_ID=
TELEGRAM_ADMIN_CHAT_ID=

# --- Publishing ---
# Master kill switch. Keep false until GATE 1 passes.
PUBLISHING_ENABLED=false

# --- Runtime ---
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
