# Copy to .env and fill in. Never commit .env.

# --- Django ----------------------------------------------------------------
# Generate a unique random value for production. Do not reuse the local value.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Docker Compose image --------------------------------------------------
NEWS_RADAR_IMAGE_TAG=local

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=news_radar
POSTGRES_USER=news_radar
POSTGRES_PASSWORD=
# Use host "postgres". URL-encode reserved characters in the password component.
DATABASE_URL=

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Ollama (org LAN) ------------------------------------------------------
# Base URL of the remote Ollama server. No trailing slash.
OLLAMA_BASE_URL=
# Pin exact model tags. Never use a moving ":latest" tag.
OLLAMA_FAST_MODEL=
OLLAMA_DEEP_MODEL=
OLLAMA_FAST_TIMEOUT=60
OLLAMA_DEEP_TIMEOUT=300

# --- LLM providers ---------------------------------------------------------
# Production defaults to Ollama. Configure MiMo only when its account permits backend use.
# Per-stage providers. Each accepts: ollama | gateway | mimo
# Setting all four to one value runs the whole pipeline on that provider.
LLM_PROVIDER=ollama
EDITORIAL_EN_PROVIDER=ollama
TRANSLATION_PROVIDER=ollama
# Triage and classification. Deliberately separate: these two stages make several
# hundred calls a day, so they should never follow the editorial provider by accident.
CLASSIFIER_PROVIDER=ollama

# Internal LLM gateway (OpenAI-compatible front door to the local GPU models).
# Models are named by tier alias, never by real model name.
GATEWAY_BASE_URL=
GATEWAY_TOKEN=
GATEWAY_FAST_MODEL=fast
GATEWAY_SMART_MODEL=smart
GATEWAY_TIMEOUT=300

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_GROUP_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_FORWARD_TTL=300
TELEGRAM_LINK_PREVIEW=true

# --- Feature gates ---------------------------------------------------------
# Safe-off defaults. Enable only after the corresponding owner acceptance gate.
BENCHMARK_VERIFICATION_ENABLED=false
POST_FORMAT_V2_ENABLED=true
POST_MAX_CHARS=450
POST_MAX_SENTENCES=3
PUBLISHING_ENABLED=false

# --- Runtime ---------------------------------------------------------------
TIME_ZONE=Asia/Tashkent
LOG_LEVEL=INFO