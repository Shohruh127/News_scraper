# Copy to .env and fill in. Never commit .env.

# --- Django ----------------------------------------------------------------
# Generate a unique random value for production. Do not reuse the local value.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Docker Compose image --------------------------------------------------
NEWS_RADAR_IMAGE_TAG=local

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=news_radar
POSTGRES_USER=news_radar
POSTGRES_PASSWORD=
# Use host "postgres". URL-encode reserved characters in the password component.
DATABASE_URL=

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- LLM providers ---------------------------------------------------------
# Production runs on the internal gateway. Configure MiMo only when its account permits
# backend use.
# Per-stage providers. Each accepts: gateway | mimo | gemini
# Setting both to one value runs the whole pipeline on that provider.
LLM_PROVIDER=gateway
EDITORIAL_UZ_PROVIDER=gateway
# Triage and classification. Deliberately separate: these two stages make several
# hundred calls a day, so they should never follow the editorial provider by accident.
CLASSIFIER_PROVIDER=gateway
# One classifier call per composition merges the same story from different outlets.
STORY_GROUPING_ENABLED=true
# Which design writes the post. uz = one call writes the Uzbek post. ru = a Russian draft
# is written first, then said in Uzbek by a second, cheap call (~+11% tokens). Measured
# 2026-09-09: the Russian draft chooses facts and structure better. Default uz until the
# chain has been judged on live days.
EDITORIAL_DRAFT_LANG=uz
# Classification scores who cares (1-10) for an ordinary reader; an article at or below this
# is skipped before any editorial cost. 3 = developers and enthusiasts only.
AUDIENCE_MIN_SCORE=3

# Output budget for the editorial call. Reasoning models bill their thinking to this before
# writing a word, so it must cover both. Measured 2026-09-08: at 5000 three calls of fifteen
# stopped mid-answer; at 8000 one dense article still hit the ceiling on three runs in a row
# and, with a single call, lost its post outright. A Russian draft plus thinking hit 12000
# four times on 2026-09-09 and finished in 6900 on the next try: runaway thinking, not a
# steady need. An unused cap costs nothing.
EDITORIAL_NUM_PREDICT=16000
# Sampling temperature for the editorial call only; triage and classification are always
# 0. Gemini's own default is 1 (max 2). At 0 the post copies the shape of the prompt's
# examples; the fact and length constraints are enforced by code after the call, not by
# the temperature.
EDITORIAL_TEMPERATURE=1.0

# Internal LLM gateway (OpenAI-compatible front door to the local GPU models).
# Models are named by tier alias, never by real model name.
GATEWAY_BASE_URL=
GATEWAY_TOKEN=
GATEWAY_FAST_MODEL=fast
GATEWAY_SMART_MODEL=smart
GATEWAY_TIMEOUT=300

# Google Gemini (Developer API). Third provider for the editorial stage:
# EDITORIAL_UZ_PROVIDER=gemini + GEMINI_API_KEY. Introductory price for
# gemini-3.8-flash: $0.75/$3.75 per 1M through 2026-12-31, then $1.50/$7.50.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Per-tier overrides, both defaulting to GEMINI_MODEL. Point GEMINI_FAST_MODEL at a
# non-thinking model before routing triage here: reasoning bills to maxOutputTokens
# before the answer is written, and triage runs on a 1000-token budget.
GEMINI_FAST_MODEL=
GEMINI_DEEP_MODEL=
GEMINI_TIMEOUT=300
GEMINI_THINKING_LEVEL=medium

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Optional. Target channel for `manage.py eval_editorial_uz --post`. Leave unset in
# production: the command refuses to post without it, which is the guard.
TELEGRAM_EVAL_CHANNEL_ID=
TELEGRAM_LINK_PREVIEW=false

# --- Feature gates ---------------------------------------------------------
# Safe-off defaults. Enable only after the corresponding owner acceptance gate.
BENCHMARK_VERIFICATION_ENABLED=false
POST_FORMAT_V2_ENABLED=true
POST_MAX_CHARS=450
POST_MAX_SENTENCES=3
DAYJEST_MAX_CHARS=900
DAYJEST_MAX_SENTENCES=7
PUBLISHING_ENABLED=false

# --- Runtime ---------------------------------------------------------------
TIME_ZONE=Asia/Tashkent
LOG_LEVEL=INFO
