[Unit]
Description=News Radar monthly PostgreSQL restore drill
Requires=docker.service
After=docker.service news-radar.service

[Service]
Type=oneshot
Environment=NEWS_RADAR_PROJECT_DIR=/opt/news-radar
Environment=NEWS_RADAR_BACKUP_DIR=/var/backups/news-radar/db
ExecStart=/opt/news-radar/ops/linux/restore-drill.sh
